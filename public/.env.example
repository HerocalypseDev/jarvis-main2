# Jarvis4U settings. Copy this file to `.env` (same folder as jarvis.py) and fill in what you use.
# `.env` is ignored by git: your keys never leave your machine through the repo.
# Most settings can also be changed later on the dashboard's Settings page.

# --- You -------------------------------------------------------------------------------------
# What Jarvis calls you ("Good morning, <name>").
JARVIS_USER_NAME=YourName

# --- The brain (at least one) ----------------------------------------------------------------
# Claude: https://console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
# Gemini (free tier available): https://aistudio.google.com/apikey
# Note: on Google's free tier, prompts may be used to improve Google products.
GEMINI_API_KEY=
# Optional: Perplexity for web search/research (answers with sources). Empty = DuckDuckGo.
PERPLEXITY_API_KEY=
# Which one answers: claude | gemini | ollama (local, see JARVIS_OLLAMA_URL / JARVIS_OLLAMA_MODEL)
JARVIS_LLM_PROVIDER=claude

# --- Voice (all optional) --------------------------------------------------------------------
# Without these, speech-to-text runs locally (Whisper) and the voice is local Piper. Both are free.
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
# Push-to-talk key (hold, speak, release) and the typed-command hotkey (hold 2 s)
JARVIS_PTT_KEY=right shift
JARVIS_TEXT_HOTKEY_KEY=left ctrl

# --- Dashboard (local web page, http://127.0.0.1:8765) ---------------------------------------
JARVIS_DASHBOARD_ENABLED=1

# --- Autonomy --------------------------------------------------------------------------------
# Autonomy lets Jarvis act on its own (from your mail, messages and conversations): create
# calendar events and reminders, send email, start background tasks. It is powerful and can be
# fooled by a cleverly written email. It starts OFF here; read AUTONOMY.md first, try dry-run
# from the dashboard, then turn it on if you want it.
JARVIS_AUTONOMY_ENABLED=0

# --- Phone (optional) ------------------------------------------------------------------------
# Send commands from your phone via ntfy.sh and/or a Telegram bot. Pick a long random topic name:
# anyone who knows it can send commands.
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Proactive pushes (reminders etc.) to the phone; replies to your own phone messages always work.
JARVIS_PHONE_PROACTIVE_NOTIFICATIONS=0

# --- Media -----------------------------------------------------------------------------------
# App whose media session "pause"/"next song" should prefer (regex over the app id), e.g. Spotify.
# Empty = whatever Windows says is playing.
JARVIS_MEDIA_APP=
# Where Jarvis keeps files it creates for you.
# JARVIS_WORKSPACE_DIR=C:\Users\you\Documents\Jarvis_Workspace

# --- Face recognition (optional, local only, off by default) ---------------------------------
JARVIS_FACE_ENABLED=0
